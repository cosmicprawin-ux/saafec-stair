# Generated outputs and logs
output/
**/run_outputs/
**/logs/
**/.cache/
*.out
*.err
*.log

# Local scheduler and cluster artifacts
*.slurm
palmetto_cpu_gpu/
slurm_logs/
scheduler_logs/
cluster_runtime/

# Python and local environments
**/__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
.hf_checkpoint_download_tmp/

# Third-party executables, models, source, and project checkpoints are restored
# locally. Only placeholder files may be tracked in these directories.
assets/external/bin/*
!assets/external/bin/.gitkeep
assets/external/models/**
!assets/external/models/**/
!assets/external/models/**/.gitkeep
assets/external/source/**
!assets/external/source/**/
!assets/external/source/**/.gitkeep
assets/checkpoints/**
!assets/checkpoints/**/
!assets/checkpoints/**/.gitkeep

# Defense in depth for model artifacts anywhere in the repository
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
